# Lu automatiquement par `docker compose` (substitutions ${...} dans
# docker-compose.yml) — copier en `.env` à la racine avant `docker compose up`.
#
# La configuration du backend vit séparément dans backend/.env — voir
# backend/.env.example.

# Clé API OpenWeatherMap (gratuite — https://openweathermap.org/api), passée en
# argument de build au frontend. Voir frontend/.env.example pour le détail.
VITE_OPENWEATHERMAP_KEY=
