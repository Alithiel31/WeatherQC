PORT=3005
NODE_ENV=development

# IP Tailscale de la machine hôte (optionnel — accès réseau distant)
TAILSCALE_IP=XXX.XXX.XX.XXX

# Origines autorisées en plus du poste local et de Tailscale, séparées par des
# virgules. En production : le domaine servi par le tunnel Cloudflare.
PUBLIC_ORIGINS=https://qcweather.alithiel31.dev

# Délai maximal d'un appel aux APIs externes (en millisecondes)
FETCH_TIMEOUT_MS=5000

# Nombre de proxies devant l'API (cloudflared + nginx = 2)
TRUST_PROXY_HOPS=2

# Limitation de débit par IP cliente
RATE_LIMIT_WINDOW_MS=60000       # fenêtre : 1 minute
RATE_LIMIT_MAX=100               # requêtes/minute sur /api
RATE_LIMIT_GEOCODE_MAX=20        # requêtes/minute sur /api/geocode

# Cache (en millisecondes)
CACHE_TTL_PREVISIONS=600000      # 10 minutes
CACHE_TTL_GEOCODE=2592000000     # 30 jours
CACHE_MAX_ENTRIES=500            # plafond du nombre d'entrées (éviction LRU)

# Timezone par défaut pour les prévisions Open-Meteo
DEFAULT_TIMEZONE=America/Toronto
